# Local development example only.
# Do not reuse these values in production.
PORT=4000
# Public frontend origin used by CORS and the backend attendance-entry redirect.
# In production, this must match apps/frontend NEXT_PUBLIC_APP_URL exactly.
FRONTEND_URL=http://localhost:3000
JWT_SECRET=konatech-local-jwt-secret-change-this-value-1234
JWT_EXPIRES_IN=1d
ATTENDANCE_ENTRY_JWT_EXPIRES_IN=15m
ORGANIZATION_SELECTION_JWT_EXPIRES_IN=5m
# Human local SaaS validation uses the isolated PostgreSQL Compose environment
# on port 5434. Keep port 5433 exclusively for the disposable E2E database.
# Put the real URL and LOCAL_SAAS_POSTGRES_PASSWORD in ignored .env.local.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/konatech_attendance_saas_validation?schema=public
# Required by the guarded `pnpm prisma:saas:bootstrap` command. Set this only
# in the ignored apps/backend/.env.local used for the dedicated local database.
SAAS_VALIDATION_BOOTSTRAP=false
JSON_BODY_LIMIT=10mb
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_TTL_MS=60000
LOGIN_RATE_LIMIT_MAX=20
TRUST_PROXY_HOPS=0
# Production: comma-separated proxy IPs/CIDRs, for example 172.16.0.0/12
TRUST_PROXY_CIDRS=
# Required in production so limits are shared by every backend instance.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS=2000
RATE_LIMIT_REDIS_COMMAND_TIMEOUT_MS=5000
ATTENDANCE_SECURITY_ENABLED=false
# Optional granular overrides. When omitted, both inherit ATTENDANCE_SECURITY_ENABLED.
ATTENDANCE_SELFIE_REQUIRED=
ATTENDANCE_GPS_REQUIRED=
# COMPANY_LATITUDE=5.359952
# COMPANY_LONGITUDE=-4.008256
# Employee self check-in/check-out uses GPS-only geofencing when enabled.
ATTENDANCE_TRUSTED_RADIUS_METERS=100
ATTENDANCE_WARNING_RADIUS_METERS=300
# Required together when selfie/photo evidence can be submitted; otherwise optional.
# Normal GPS-only attendance does not require these values.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_ATTENDANCE_FOLDER=konatech/attendance-verifications
CLOUDINARY_UPLOAD_TIMEOUT_MS=10000
CLOUDINARY_UPLOAD_MAX_RETRIES=2
CLOUDINARY_UPLOAD_RETRY_DELAY_MS=300
# Monthly HR PDF exports use the premium Puppeteer renderer by default.
# Configure this path if Chromium is not discoverable automatically.
ATTENDANCE_PDF_RENDERER=premium
# Windows example:
# ATTENDANCE_PDF_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Linux/Docker example:
# ATTENDANCE_PDF_EXECUTABLE_PATH=/usr/bin/chromium
ATTENDANCE_PDF_ALLOW_LEGACY_FALLBACK=false
