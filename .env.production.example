# Docker Compose production example.
# Copy this file to .env.production and replace every placeholder before deploy.

FRONTEND_URL=https://staging-pointage.konatech.org
NEXT_PUBLIC_APP_URL=https://staging-pointage.konatech.org
NEXT_PUBLIC_API_BASE_URL=https://staging-api-pointage.konatech.org/api/v1
API_BASE_URL=http://backend:4000/api/v1
FRONTEND_HOST=staging-pointage.konatech.org
BACKEND_HOST=staging-api-pointage.konatech.org

# Neon PostgreSQL connection string for staging.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/YOUR_DATABASE?sslmode=require

JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=1d
ATTENDANCE_ENTRY_JWT_EXPIRES_IN=15m
ORGANIZATION_SELECTION_JWT_EXPIRES_IN=5m
# Trust only the reverse-proxy network; hop counts are unsafe when the backend
# can be reached through paths with different proxy lengths.
TRUST_PROXY_CIDRS=172.16.0.0/12
TRUST_PROXY_HOPS=0
RATE_LIMIT_REDIS_URL=rediss://USER:PASSWORD@REDIS_HOST:6379/0
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS=2000
RATE_LIMIT_REDIS_COMMAND_TIMEOUT_MS=5000

JSON_BODY_LIMIT=10mb
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_TTL_MS=60000
LOGIN_RATE_LIMIT_MAX=20

ATTENDANCE_SECURITY_ENABLED=false
# Optional granular overrides. When omitted, both inherit ATTENDANCE_SECURITY_ENABLED.
ATTENDANCE_SELFIE_REQUIRED=
ATTENDANCE_GPS_REQUIRED=
# COMPANY_LATITUDE=5.359952
# COMPANY_LONGITUDE=-4.008256
ATTENDANCE_TRUSTED_RADIUS_METERS=100
ATTENDANCE_WARNING_RADIUS_METERS=300
ATTENDANCE_MAX_ACCURACY_METERS=200
# ATTENDANCE_ALLOWED_RADIUS_METERS=300
# Premium monthly HR report renderer. Use legacy only for an explicit rollback.
ATTENDANCE_PDF_RENDERER=premium
ATTENDANCE_PDF_EXECUTABLE_PATH=/usr/bin/chromium
ATTENDANCE_PDF_ALLOW_LEGACY_FALLBACK=false

# Required together when selfie/photo evidence can be submitted; otherwise optional.
# They may also be needed to retain legacy historical photo evidence workflows.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_ATTENDANCE_FOLDER=konatech/attendance-verifications
CLOUDINARY_UPLOAD_TIMEOUT_MS=10000
CLOUDINARY_UPLOAD_MAX_RETRIES=2
CLOUDINARY_UPLOAD_RETRY_DELAY_MS=300
